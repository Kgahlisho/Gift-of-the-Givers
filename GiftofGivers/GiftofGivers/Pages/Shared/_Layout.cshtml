<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark gotg-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <span class="gotg-logo">GG</span>
                    <span class="fw-bold">Gift of the Givers</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/About">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Donation/Index">Donate</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Volunteer/Register">Volunteer</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Contact">Contact</a></li>
                        @if (User.IsInRole("Employee"))
                        {
                        <li class="nav-item"><a class="nav-link" asp-page="/Employee/Dashboard">Employee Dashboard</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                        <li class="nav-item d-flex align-items-center text-light me-3">
                            Hi, @User.Identity.Name
                        </li>
                        <li class="nav-item">
                            <form asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index")" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                            </form>
                        </li>
                        }
                        else
                        {
                        <li class="nav-item"><a class="btn btn-outline-light btn-sm me-2" asp-page="/Account/Login">Log in</a></li>
                        <li class="nav-item"><a class="btn btn-light btn-sm" asp-page="/Account/Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @if (TempData["Success"] != null)
        {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show">@TempData["Success"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        </div>
        }
        @if (TempData["Error"] != null)
        {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        </div>
        }
        @RenderBody()
    </main>

    <footer class="gotg-footer text-center text-light py-4 mt-5">
        <div class="container">
            <p class="mb-1">&copy; @DateTime.Now.Year Gift of the Givers Foundation - Prototype System</p>
            <small>Compassion &bull; Efficiency &bull; Resilience</small>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
