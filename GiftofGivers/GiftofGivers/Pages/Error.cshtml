@page
@model GiftofGivers.Pages.ErrorModel
@{
    ViewData["Title"] = "Error - Gift of the Givers";
}

<div class="container py-5">
    <h1 class="text-danger">Something went wrong</h1>
    <p>An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index">Return to Home</a>
</div>
