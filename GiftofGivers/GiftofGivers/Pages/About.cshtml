@page
@model GiftofGivers.Pages.AboutModel
@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <h1>About Gift of the Givers</h1>
    <p class="lead">
        The Gift of the Givers Foundation is dedicated to providing swift, effective, and organised
        relief efforts to communities affected by natural disasters and emergencies, in South Africa
        and internationally.
    </p>
    <div class="row mt-4 g-4">
        <div class="col-md-4">
            <div class="card card-gotg p-4 h-100">
                <h5>Compassion</h5>
                <p>Every response is driven by care for the people affected, not just logistics.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-gotg p-4 h-100">
                <h5>Efficiency</h5>
                <p>Resources are mobilised quickly and coordinated to avoid duplication or waste.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-gotg p-4 h-100">
                <h5>Resilience</h5>
                <p>We support communities not just in crisis response, but in rebuilding afterwards.</p>
                <p class="text-muted small mt-3">This prototype is built and validated using Azure DevOps CI pipelines to ensure every change is tested before release.</p>
            </div>
        </div>
    </div>
</div>
