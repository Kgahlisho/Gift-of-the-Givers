@page
@model GiftofGivers.Pages.Donation.IndexModel
@{
    ViewData["Title"] = "Make a Donation";
}

<div class="container py-5" style="max-width:600px;">
    <h1 class="mb-3">Make a Donation</h1>
    <p class="text-muted">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <span>Donating as <strong>@User.Identity.Name</strong>. You can also choose to donate anonymously below.</span>
        }
        else
        {
            <span>You're not logged in - you can donate as a guest, or <a asp-area="Identity" asp-page="/Account/Login">log in</a> to track your donation history.</span>
        }
   
    <!--Just for testing-->
    </p>
    
   
    
    <form method="post" class="card card-gotg p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @if (User.Identity == null || !User.Identity.IsAuthenticated)
        {
            <div class="mb-3">
                <label class="form-label">Your Name (optional if donating anonymously)</label>
                <input asp-for="Donation.DonorName" class="form-control" placeholder="e.g. Jane Dlamini" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email (optional)</label>
                <input asp-for="Donation.DonorEmail" class="form-control" placeholder="you@example.com" />
            </div>
        }
        else
        {
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="DonateAsGuest" id="guestCheck" />
                <label class="form-check-label" for="guestCheck">Donate anonymously instead of using my account</label>
            </div>
        }

        <div class="mb-3">
            <label class="form-label">Amount</label>
            <input asp-for="Donation.Amount" type="number" step="0.01" class="form-control" placeholder="e.g. 250" />
            <span asp-validation-for="Donation.Amount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Currency</label>
            <select asp-for="Donation.Currency" class="form-select">
                <option value="ZAR">ZAR - South African Rand</option>
                <option value="USD">USD - US Dollar</option>
                <option value="EUR">EUR - Euro</option>
            </select>
        </div>

        <div class="mb-4">
            <label class="form-label d-block">Donation Type</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Donation.Frequency" value="OneTime" checked />
                <label class="form-check-label">One-Time</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Donation.Frequency" value="Recurring" />
                <label class="form-check-label">Recurring (Monthly)</label>
            </div>
        </div>

        <button type="submit" class="btn btn-gotg btn-lg w-100">Donate</button>
        <p class="text-muted small mt-3 mb-0">
            Prototype note: no real payment is processed. This records a dummy donation and
            generates a placeholder tax certificate.
        </p>
    </form>
</div>
