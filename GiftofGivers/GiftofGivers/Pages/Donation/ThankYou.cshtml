@page "{id:int}"
@model GiftofGivers.Pages.Donation.ThankYouModel
@{ ViewData["Title"] = "Thank You for Your Donation";}

    <div class="container py-5 text-center" style="max-width:600px;">
    <h1 class="mb-3">Thank You, @Model.Donation.DonorName!</h1>
    <p class="lead">
        Your @(Model.Donation.Frequency == DonationFrequency.OneTime ? "one-time" : "recurring") donation of
        <strong>@Model.Donation.Currency @Model.Donation.Amount.ToString("N2")</strong> has been recorded.
    </p>
    <p class="text-muted">Reference: @Model.Donation.CertificateReference</p>

    <a class="btn btn-gotg btn-lg mt-3" asp-page="Certificate" asp-route-id="@Model.Donation.Id">
        Download Tax Certificate (PDF)
    </a>
    <div class="mt-4">
        <a asp-page="/Index">Return to Home</a>
    </div>
</div>
